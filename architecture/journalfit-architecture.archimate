<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="JournalFit Cloud-Native Platform (Team 7 - M2 Baseline)" id="id-model-journalfit" version="5.0.0">
  <purpose>Model arsitektur ArchiMate 3.2 JournalFit (Milestone 2 Baseline 7e8607b / tag 0c2cf92): Keycloak OIDC 26.8.2, Express 5 Modular Monolith, pg-boss worker-format, OOXML Tier-1 FMT-001..009, PostgreSQL 17, k3d HPA, Prometheus/Grafana, dan Argo CD GitOps.</purpose>
  <folder name="Strategy" id="id-folder-strategy" type="strategy"/>
  <folder name="Business" id="id-folder-business" type="business">
    <element xsi:type="archimate:BusinessActor" name="Author (Penulis)" id="id-ba-author">
      <documentation>Submitter role (author.a, author.b)</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Journal Editor" id="id-ba-editor">
      <documentation>Reviewer role (editor.a)</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="1. OIDC Tenant Login" id="id-bp-auth">
      <documentation>Authenticate via Keycloak (realm journalfit) -&gt; RS256 Bearer JWT</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="2. Submit Naskah (.docx)" id="id-bp-submit">
      <documentation>POST /api/manuscripts (202 Accepted) -&gt; PVC + pg-boss enqueue</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="3. Async OOXML Format Audit" id="id-bp-audit">
      <documentation>worker-format evaluates Tier-1 FMT-001..009 ($0 AI cost)</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="4. Tinjau Laporan &amp; Revisi" id="id-bp-review">
      <documentation>GET /api/manuscripts/:id/report (&lt; 50 ms), cross-tenant 404</documentation>
    </element>
  </folder>
  <folder name="Application" id="id-folder-application" type="application">
    <element xsi:type="archimate:ApplicationService" name="Layanan Validasi Format Naskah" id="id-as-check">
      <documentation>Multi-tenant asynchronous DOCX format pre-check service</documentation>
    </element>
    <element xsi:type="archimate:ApplicationInterface" name="Traefik Ingress Gateway (:8088)" id="id-ai-ingress">
      <documentation>journalfit.localhost -&gt; backend:80 | keycloak.localhost -&gt; keycloak:80</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Keycloak OIDC Provider (26.8.2)" id="id-ac-keycloak">
      <documentation>Realm journalfit | RS256 Token &amp; Internal JWKS (~596 MiB RAM)</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="JournalFit Backend API (Express 5)" id="id-ac-api">
      <documentation>Node.js 22 + Express 5.3 + jose JWKS + OpenAPI /docs + /metrics</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Job Queue (pg-boss)" id="id-ac-queue">
      <documentation>PostgreSQL-backed queue format-check + format-check-dlq (atomic TX)</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Worker Format (OOXML Engine)" id="id-ac-worker">
      <documentation>node src/worker.js | jszip + fast-xml-parser | FMT-001..009 | :9101</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Bearer JWT (RS256)" id="id-do-jwt">
      <documentation>Claims: iss, sub, tenant_id, role (X-Tenant-ID ignored)</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Naskah (.docx)" id="id-do-docx">
      <documentation>Binary stored in PVC /app/uploads (shared by API &amp; worker)</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Template Aturan (FMT-001..009)" id="id-do-rules">
      <documentation>Tenant-scoped Tier-1 rules in format_rule_templates</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Laporan &amp; Findings" id="id-do-report">
      <documentation>format_score, check_results, findings (tenant-isolated)</documentation>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-folder-technology" type="technology">
    <element xsi:type="archimate:Device" name="Client / Browser / API Caller" id="id-dv-client">
      <documentation>Author &amp; Editor external client accessing HTTP :8088</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Traefik Ingress (:8088)" id="id-ts-ingress">
      <documentation>Cluster HTTP entrypoint [TB-1 Perimeter Boundary]</documentation>
    </element>
    <element xsi:type="archimate:Node" name="k3d-capstone (k3s v1.31 / agent-0)" id="id-nd-k3d">
      <documentation>Containerd runtime, label journalfit-storage=uploads</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Pod: keycloak (UID 1000, 1x)" id="id-ss-kc">
      <documentation>quay.io/keycloak/keycloak:26.8.2 | Req 250m/512Mi Lim 1000m/1Gi | Svc :80-&gt;:8080</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Pod: journalfit-backend (2-3 HPA)" id="id-ss-api">
      <documentation>registry:5000/journalfit-backend:0c2cf92 | UID 10001 drop ALL | Self-heal 7.1s</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Pod: worker-format (UID 10001, 1x)" id="id-ss-worker">
      <documentation>node src/worker.js | Req 100m/128Mi Lim 250m/256Mi | Metrics :9101</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Job: db-setup (migrate + seed)" id="id-ss-job">
      <documentation>InitContainer run-migrations.js (001+002) + seed-demo-data.js | UID 10001</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="PVC: journalfit-uploads (1Gi RWO)" id="id-ar-pvc">
      <documentation>local-path RWO /app/uploads [FB-2 single-node pinned, Prune=false]</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="K8s Secrets &amp; ConfigMaps" id="id-ar-sec">
      <documentation>journalfit-backend-secret, keycloak-db/admin-secret, AUTH_MODE=jwt [TB-4]</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="PostgreSQL 17 Alpine (:5432)" id="id-ss-pg">
      <documentation>DB journalfit (6 tables + pg-boss) &amp; DB keycloak (101 tables)</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Backup &amp; Isolated Restore" id="id-ts-backup">
      <documentation>db-backup-restore.sh | Verified RTO 0.78s (&lt; 300s SLO) [FB-3]</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Prometheus (:9090) &amp; Grafana (:3000)" id="id-ss-obs">
      <documentation>Scrapes /metrics 15s, TSDB 3d retention, 4 Golden Signals SLO</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="GitHub Actions CI" id="id-ss-gha">
      <documentation>node --test (63/64 PASS) + Trivy Gate (HIGH,CRITICAL) + SHA-7</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Local OCI Registry (:5001/:5000)" id="id-ss-reg">
      <documentation>Immutable artifact registry:5000/journalfit-backend:0c2cf92</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Argo CD GitOps Controller" id="id-ss-argo">
      <documentation>Auto-Sync &amp; Self-Heal (main -&gt; deployment/), rollback &lt; 15s</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="id-folder-motivation" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Penulis / Mahasiswa" id="id-st-author">
      <documentation>Ingin self-check format .docx sebelum submit resmi</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Editor Jurnal" id="id-st-editor">
      <documentation>Ingin naskah rapi secara format tanpa cek manual 10-40 menit</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Admin Tenant" id="id-st-tadmin">
      <documentation>Menjaga kerahasiaan &amp; isolasi data naskah antar jurnal</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Admin Platform" id="id-st-padmin">
      <documentation>Menjaga SLO, efisiensi FinOps, dan stabilitas kluster</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Cek Manual &amp; &gt;30% Desk Rejection" id="id-dr-manual">
      <documentation>Siklus revisi 2-3x dan 16-25 jam/100 naskah</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Lonjakan Trafik 10x Jelang Deadline" id="id-dr-burst">
      <documentation>Beban musiman ekstrem saat call-for-papers / yudisium</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Kerahasiaan Naskah &amp; FinOps" id="id-dr-sec">
      <documentation>Naskah belum terbit sensitif; hindari biaya AI tinggi di v1</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Audit Format Otomatis &amp; Cepat" id="id-gl-audit">
      <documentation>Tier-1 FMT-001..009 deterministik, report p95 &lt; 50 ms</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Isolasi Multi-Tenant &amp; Resilience" id="id-gl-iso">
      <documentation>0 kebocoran data (401/404/403), self-heal 7.1s, RTO 0.78s</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Efisiensi Biaya ($0 AI Cost v1)" id="id-gl-cost">
      <documentation>Deterministic OOXML tanpa token LLM berbayar di v1</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Pemrosesan Asinkron (pg-boss) + HPA" id="id-rq-async">
      <documentation>Decouple upload API (202) dan worker-format + HPA 2-3 pod</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Rule Engine OOXML (FMT-001..009)" id="id-rq-ooxml">
      <documentation>jszip + fast-xml-parser untuk A4, margin, font, abstrak, keywords</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Keycloak OIDC RS256 + Policy 404" id="id-rq-oidc">
      <documentation>Claim tenant_id terverifikasi JWKS, abaikan X-Tenant-ID</documentation>
    </element>
    <element xsi:type="archimate:Requirement" name="Backup &amp; Isolated Restore Drill" id="id-rq-dr">
      <documentation>Target SLO RTO &lt; 5 menit (teruji 0.78 detik)</documentation>
    </element>
    <element xsi:type="archimate:Constraint" name="v1 Hanya DOCX &amp; PVC RWO (S3/AI di v2)" id="id-ct-scope">
      <documentation>Garage S3 &amp; Groq AI scope checker masuk Roadmap v2</documentation>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-folder-implementation_migration" type="implementation_migration"/>
  <folder name="Other" id="id-folder-other" type="other">
    <element xsi:type="archimate:Grouping" name="Trust Boundary: Kubernetes Data Plane [TB-1..TB-4]" id="id-gp-platform">
      <documentation>Perimeter :8088, RS256 JWKS, Multi-Tenant 404, Non-Root UID 10001</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Host Node: Docker Engine (DB &amp; Observability)" id="id-gp-host">
      <documentation>PostgreSQL 17, Backup/Restore [FB-3], Prometheus &amp; Grafana</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Control Plane: CI/CD &amp; GitOps (Out-of-Band)" id="id-gp-cicd">
      <documentation>GitHub Actions -&gt; OCI Registry -&gt; Argo CD Auto-Sync</documentation>
    </element>
  </folder>
  <folder name="Relations" id="id-folder-relations" type="relations">
    <element xsi:type="archimate:AssociationRelationship" id="id-r-m1" source="id-st-author" target="id-dr-manual"/>
    <element xsi:type="archimate:AssociationRelationship" id="id-r-m2" source="id-st-editor" target="id-dr-manual"/>
