  </folder>
  <folder name="Views" id="id-folder-views" type="diagrams">
    <element xsi:type="archimate:ArchimateDiagramModel" name="1. Motivation view (01-business)" id="id-v1" connectionRouterType="1">
      <child xsi:type="archimate:DiagramObject" id="id-v1-d-id-st-author" archimateElement="id-st-author">
        <bounds x="30" y="30" width="180" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v1-c-id-r-m1" source="id-v1-d-id-st-author" target="id-v1-d-id-dr-manual" archimateRelationship="id-r-m1"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v1-d-id-st-editor" archimateElement="id-st-editor">
        <bounds x="240" y="30" width="180" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v1-c-id-r-m2" source="id-v1-d-id-st-editor" target="id-v1-d-id-dr-manual" archimateRelationship="id-r-m2"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v1-c-id-r-m3" source="id-v1-d-id-st-editor" target="id-v1-d-id-dr-burst" archimateRelationship="id-r-m3"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v1-d-id-st-tadmin" archimateElement="id-st-tadmin">
        <bounds x="450" y="30" width="180" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v1-c-id-r-m4" source="id-v1-d-id-st-tadmin" target="id-v1-d-id-dr-sec" archimateRelationship="id-r-m4"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v1-d-id-st-padmin" archimateElement="id-st-padmin">
        <bounds x="660" y="30" width="180" height="55"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v1-c-id-r-m5" source="id-v1-d-id-st-padmin" target="id-v1-d-id-dr-sec" archimateRelationship="id-r-m5"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v1-d-id-dr-manual" targetConnections="id-v1-c-id-r-m1 id-v1-c-id-r-m2" archimateElement="id-dr-manual">
        <bounds x="40" y="130" width="240" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v1-c-id-r-m6" source="id-v1-d-id-dr-manual" target="id-v1-d-id-gl-audit" archimateRelationship="id-r-m6"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v1-d-id-dr-burst" targetConnections="id-v1-c-id-r-m3" archimateElement="id-dr-burst">
        <bounds x="310" y="130" width="240" height="60"/>
        <sourceConnection xsi:type="archimate:Connection" id="id-v1-c-id-r-m7" source="id-v1-d-id-dr-burst" target="id-v1-d-id-gl-audit" archimateRelationship="id-r-m7"/>
      </child>
      <child xsi:type="archimate:DiagramObject" id="id-v1-d-id-dr-sec" targetConnections="id-v1-c-id-r-m4 id-v1-c-id-r-m5" archimateElement="id-dr-sec">
