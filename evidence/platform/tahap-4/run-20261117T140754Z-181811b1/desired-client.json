{
  "ConfigMap": {
    "apiVersion": "v1",
    "data": {
      "DB_HOST": "host.docker.internal",
      "DB_NAME": "journalfit",
      "DB_PORT": "5432",
      "DB_USER": "capstone",
      "NODE_ENV": "production",
      "PORT": "8000"
    },
    "kind": "ConfigMap",
    "metadata": {
      "name": "journalfit-backend-config",
      "namespace": "default"
    }
  },
  "Service": {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "journalfit-backend",
      "namespace": "default"
    },
    "spec": {
      "ports": [
        {
          "name": "http",
          "port": 80,
          "targetPort": "http"
        }
      ],
      "selector": {
        "app": "journalfit"
      },
      "type": "ClusterIP"
    }
  },
  "PersistentVolumeClaim": {
    "apiVersion": "v1",
    "kind": "PersistentVolumeClaim",
    "metadata": {
      "annotations": {
        "argocd.argoproj.io/sync-options": "Prune=false,Delete=false"
      },
      "name": "journalfit-uploads",
      "namespace": "default"
    },
    "spec": {
      "accessModes": [
        "ReadWriteOnce"
      ],
      "resources": {
        "requests": {
          "storage": "1Gi"
        }
      },
      "storageClassName": "local-path"
    }
  },
  "Deployment": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "journalfit-backend",
      "namespace": "default"
    },
    "spec": {
      "minReadySeconds": 5,
      "progressDeadlineSeconds": 180,
      "revisionHistoryLimit": 3,
      "selector": {
        "matchLabels": {
          "app": "journalfit"
        }
      },
      "strategy": {
        "rollingUpdate": {
          "maxSurge": 1,
          "maxUnavailable": 0
        },
        "type": "RollingUpdate"
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "journalfit"
          }
        },
        "spec": {
          "automountServiceAccountToken": false,
          "containers": [
            {
              "env": [
                {
                  "name": "DB_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "DB_PASSWORD",
                      "name": "journalfit-backend-secret"
                    }
                  }
                }
              ],
              "envFrom": [
                {
                  "configMapRef": {
                    "name": "journalfit-backend-config"
                  }
                }
              ],
              "image": "registry:5000/journalfit-backend:stage2-20261117t055120z-d9ab35a",
              "imagePullPolicy": "Always",
              "livenessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "path": "/health/live",
                  "port": "http"
                },
                "periodSeconds": 10,
                "timeoutSeconds": 2
              },
              "name": "backend",
              "ports": [
                {
                  "containerPort": 8000,
                  "name": "http"
                }
              ],
              "readinessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "path": "/health/ready",
                  "port": "http"
                },
                "periodSeconds": 5,
                "timeoutSeconds": 2
              },
              "resources": {
                "limits": {
                  "cpu": "250m",
                  "memory": "256Mi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "128Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              },
              "startupProbe": {
                "failureThreshold": 12,
                "httpGet": {
                  "path": "/health/live",
                  "port": "http"
                },
                "periodSeconds": 5,
                "timeoutSeconds": 2
              },
              "volumeMounts": [
                {
                  "mountPath": "/app/uploads",
                  "name": "uploads"
                }
              ]
            }
          ],
          "nodeSelector": {
            "journalfit-storage": "uploads"
          },
          "securityContext": {
            "fsGroup": 10001,
            "fsGroupChangePolicy": "OnRootMismatch",
            "runAsGroup": 10001,
            "runAsNonRoot": true,
            "runAsUser": 10001
          },
          "volumes": [
            {
              "name": "uploads",
              "persistentVolumeClaim": {
                "claimName": "journalfit-uploads"
              }
            }
          ]
        }
      }
    }
  },
  "HorizontalPodAutoscaler": {
    "apiVersion": "autoscaling/v2",
    "kind": "HorizontalPodAutoscaler",
    "metadata": {
      "name": "journalfit-backend",
      "namespace": "default"
    },
    "spec": {
      "behavior": {
        "scaleDown": {
          "policies": [
            {
              "periodSeconds": 30,
              "type": "Pods",
              "value": 1
            }
          ],
          "stabilizationWindowSeconds": 60
        },
        "scaleUp": {
          "policies": [
            {
              "periodSeconds": 30,
              "type": "Pods",
              "value": 1
            }
          ],
          "stabilizationWindowSeconds": 0
        }
      },
      "maxReplicas": 3,
      "metrics": [
        {
          "resource": {
            "name": "cpu",
            "target": {
              "averageUtilization": 70,
              "type": "Utilization"
            }
          },
          "type": "Resource"
        }
      ],
      "minReplicas": 2,
      "scaleTargetRef": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "name": "journalfit-backend"
      }
    }
  },
  "Ingress": {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "Ingress",
    "metadata": {
      "name": "journalfit-backend",
      "namespace": "default"
    },
    "spec": {
      "ingressClassName": "traefik",
      "rules": [
        {
          "host": "journalfit.localhost",
          "http": {
            "paths": [
              {
                "backend": {
                  "service": {
                    "name": "journalfit-backend",
                    "port": {
                      "number": 80
                    }
                  }
                },
                "path": "/",
                "pathType": "Prefix"
              }
            ]
          }
        }
      ]
    }
  }
}
