PORT=8000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=journalfit
KEYCLOAK_DB_NAME=keycloak

# Optional full connection string. When set it takes precedence over DB_*.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/journalfit

# Authentication (jwt | header | mock). header/mock are dev-only.
AUTH_MODE=jwt
KEYCLOAK_ISSUER=http://localhost:8081/realms/journalfit
KEYCLOAK_JWKS_URI=http://localhost:8081/realms/journalfit/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=journalfit-api

# Format-check pipeline
MAX_UPLOAD_MB=10
UPLOAD_DIR=uploads
PG_BOSS_SCHEMA=pgboss
FORMAT_QUEUE=format-check
SCOPE_QUEUE=scope-check
WORKER_TYPE=format
WORKER_METRICS_PORT=9101
ENABLE_DOCS=false

# AI scope check (mock | groq)
AI_MODE=mock
# GROQ_API_KEY=replace-with-secret
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_MS=30000
AI_PRICE_IN_PER_1M=0
AI_PRICE_OUT_PER_1M=0

# Storage (local | s3)
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=journalfit-manuscripts
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Metrics (set METRICS_PUBLIC=false when an Ingress exposes the API)
METRICS_PUBLIC=true
METRICS_PORT=9100
