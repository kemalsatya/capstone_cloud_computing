# JournalFit Project Environment Configuration

# Application & Database Settings
PORT=8000
NODE_ENV=development
DB_HOST=postgres
DB_PORT=5432
DB_USER=capstone
DB_PASSWORD=capstone
DB_NAME=journalfit
KEYCLOAK_DB_NAME=keycloak

# Gitea & Local Registry (Profile: ci-cd)
GITEA_VERSION=1.22
GITEA_PORT=3001
GITEA_SSH_PORT=2222
REGISTRY_PORT=5001

# Observability (Profile: observability)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Cluster Settings (k3d)
K3D_CLUSTER_NAME=capstone
K3D_HTTP_PORT=8088
K3D_HTTPS_PORT=8443

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8081

# Authentication (jwt | header | mock). header/mock are dev-only.
AUTH_MODE=jwt
KEYCLOAK_ISSUER=http://localhost:8081/realms/journalfit
KEYCLOAK_AUDIENCE=journalfit-api
# KEYCLOAK_JWKS_URI is set inside the compose network by default
# (http://keycloak:8080/realms/journalfit/protocol/openid-connect/certs).

# AI scope check (mock | groq)
AI_MODE=mock
# GROQ_API_KEY=replace-with-secret
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_MS=30000
AI_PRICE_IN_PER_1M=0
AI_PRICE_OUT_PER_1M=0
WORKER_SCOPE_METRICS_PORT=9102

# Storage (local | s3). Use s3 to send DOCX to Garage.
STORAGE_DRIVER=local
S3_ENDPOINT=http://garage:3900
S3_BUCKET=journalfit-manuscripts
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=journalfit
S3_SECRET_KEY=journalfit-secret

# Internal API metrics port
API_METRICS_PORT=9100
METRICS_PUBLIC=true